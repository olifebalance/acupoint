{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'x', 'y'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().length === 7 && newData.val().matches(/^#[0-9a-fA-F]+$/)"
        },
        "g": {
          ".validate": "newData.val() === 'f' || newData.val() === 'm'"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
        },
        "f": {
          ".validate": "newData.isBoolean()"
        },
        "w": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "s": {
          ".validate": "newData.isNumber()"
        },
        "sx": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
        },
        "sy": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
        },
        "su": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "houses": {
      ".read": true
    },
    "hearts": {
      ".read": true,
      "$house": {
        ".write": "auth != null && newData.exists()",
        ".validate": "root.child('houses').child($house).exists() && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.parent().parent().child('given').child(auth.uid).child($house).val() === now"
      }
    },
    "given": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$house": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "root.child('houses').child($house).exists() && newData.val() === now && (!data.exists() || data.val() < now - 72000000)"
        }
      }
    },
    "warm": {
      ".read": true,
      "$house": {
        ".write": "auth != null && newData.exists()",
        ".validate": "root.child('houses').child($house).exists() && newData.val() === now && newData.parent().parent().child('given').child(auth.uid).child($house).val() === now"
      }
    },
    "visits": {
      ".read": true,
      "$day": {
        "$house": {
          ".write": "auth != null && newData.exists()",
          ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && root.child('houses').child($house).exists() && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.parent().parent().parent().child('seen').child(auth.uid).child($house).val() === $day && root.child('seen').child(auth.uid).child($house).val() !== $day"
        }
      }
    },
    "seen": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$house": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "root.child('houses').child($house).exists() && newData.isString() && newData.val().matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
        }
      }
    },
    "snowmen": {
      ".read": true,
      "$house": {
        ".write": "auth != null && newData.exists() && (!data.exists() || data.child('t').val() < now - 90000000)",
        ".validate": "root.child('houses').child($house).exists() && newData.hasChildren(['n', 't'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().length === 7 && newData.val().matches(/^#[0-9a-fA-F]+$/)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
